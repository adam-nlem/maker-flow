##### Docker Compose #####
COMPOSE_PROJECT_NAME=makerflow

##### Backend SYMFONY #####

###> symfony ###
APP_ENV=prod
# Generate with: php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=CHANGE_ME
APP_DOMAIN=maker-flow.com
###< symfony ###

###> encryption ###
# 32-byte key as hex (64 chars). Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_ENCRYPTION_KEY=CHANGE_ME
###< encryption ###

###> mysql ###
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MYSQL_DATABASE=maker_flow
MYSQL_DATABASE_HOST=db
MYSQL_USER=maker_flow
MYSQL_PASSWORD=CHANGE_ME_STRONG_PASSWORD
###< mysql ###

###> redis store ###
REDIS_STORE_HOST=redis-store
REDIS_STORE_PORT=6379
REDIS_STORE_SCHEME=tcp
REDIS_STORE_PASSWORD=CHANGE_ME_STRONG_PASSWORD
###< redis store ###

###> rabbitmq ###
RABBITMQ_USER=maker_flow
RABBITMQ_PASSWORD=CHANGE_ME_STRONG_PASSWORD
RABBITMQ_VHOST=maker_flow
###< rabbitmq ###

##### Domains (used by Traefik labels) #####
FRONTEND_DOMAIN=maker-flow.com
API_DOMAIN=api.maker-flow.com

###> cloudflare ###
# API token with Zone:DNS:Edit permission — used by Traefik for DNS-01 ACME challenge
CF_DNS_API_TOKEN=CHANGE_ME
# Last updated: 2025-01 — https://www.cloudflare.com/ips-v4/#
CLOUDFLARE_IPS=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22
###< cloudflare ###

##### Frontend REACT #####
API_URL=https://api.maker-flow.com
FRONTEND_URL=https://maker-flow.com

##### Instagram #####
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://api.maker-flow.com/api/integrations/instagram/callback

###> youtube ###
YOUTUBE_CLIENT_ID=
YOUTUBE_PROJECT_ID=
YOUTUBE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
YOUTUBE_TOKEN_URI=https://oauth2.googleapis.com/token
YOUTUBE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://api.maker-flow.com/api/integrations/youtube/callback
YOUTUBE_JAVASCRIPT_ORIGIN=https://maker-flow.com
###< youtube ###

###> gemini ###
GEMINI_API_KEY=
###< gemini ###

###> openai ###
OPENAI_API_KEY=
###< openai ###

###> claude ###
ANTHROPIC_API_KEY=
###< claude ###

###> stripe ###
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
###< stripe ###

###> sentry ###
SENTRY_DSN_BACK=
SENTRY_DSN_FRONT=
###< sentry ###

###> mailing ###
RESEND_API_KEY=
MAILING_FROM_ADDRESS=
MAILING_FROM_NAME=
###< mailing ###

###> prelaunch ###
PRELAUNCH_ENABLED=false
###< prelaunch ###
