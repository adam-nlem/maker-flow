FROM composer:2 AS composer-deps

WORKDIR /app

# Install ext-amqp (required by symfony/amqp-messenger)
RUN apk add --no-cache autoconf build-base rabbitmq-c-dev && pecl install amqp && docker-php-ext-enable amqp

COPY composer.json composer.lock ./
RUN composer install --no-dev --optimize-autoloader --no-scripts --no-interaction

# ---

FROM php:8.2-apache

# Install PHP extensions and clean up dev libs in one layer
RUN apt-get update && apt-get install -y --no-install-recommends \
    libsodium-dev \
    libicu-dev \
    librabbitmq-dev \
    libcurl4-openssl-dev \
    zlib1g-dev \
    libpng-dev \
    libonig-dev \
    libzip-dev \
    && docker-php-ext-install pdo pdo_mysql sodium intl curl fileinfo gd zip opcache \
    && pecl install amqp && docker-php-ext-enable amqp \
    && apt-get purge -y --auto-remove \
        libsodium-dev libicu-dev librabbitmq-dev libcurl4-openssl-dev \
        zlib1g-dev libpng-dev libonig-dev libzip-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/* /tmp/pear

# Apache modules
RUN a2enmod rewrite headers

# Apache production config
COPY .docker/apache2/000-default.prod.conf /etc/apache2/sites-available/000-default.conf

# Disable Apache server tokens
RUN echo "ServerTokens Prod" >> /etc/apache2/conf-enabled/security.conf

# PHP OPcache config
COPY .docker/php/opcache.ini /usr/local/etc/php/conf.d/opcache.ini

# Copy vendor from composer stage
COPY --from=composer-deps /app/vendor /var/www/html/vendor

# Copy application source
COPY . /var/www/html

# Remove files not needed in production
RUN rm -rf /var/www/html/tests /var/www/html/.git /var/www/html/.env.local

# Symfony requires a .env file to exist even when env vars are injected via Docker
RUN echo "APP_ENV=prod\nAPP_DEBUG=0" > /var/www/html/.env

# Create var directory for Symfony cache/logs
RUN mkdir -p /var/www/html/var \
    && chown -R www-data:www-data /var/www/html

# Production entrypoint
COPY .docker/build/docker-entrypoint.prod.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

WORKDIR /var/www/html

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]

EXPOSE 80

CMD ["/usr/sbin/apachectl", "-D", "FOREGROUND"]
